# ─── Frontend ───────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api

# ─── Backend (apps/api/.env) ────────────────────────
# Copy these to apps/api/.env for local development.

# PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/halo

# JWT Secrets (generate with: openssl rand -base64 48)
# JWT_ACCESS_SECRET=your-access-secret
# JWT_REFRESH_SECRET=your-refresh-secret

# Admin Seed Account
# ADMIN_EMAIL=admin@halo.pk
# ADMIN_PASSWORD=Admin@2025
# ADMIN_FIRST_NAME=HALO
# ADMIN_LAST_NAME=Admin

# Cloudinary (optional — dev mode uses local stubs)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SMTP / Email (optional — dev mode logs failures)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@halo.pk

# Server
# PORT=4000
# NODE_ENV=development
